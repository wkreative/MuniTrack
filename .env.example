# MuniTrack - Variables de Entorno para Vercel & Google Cloud

# 1. Google Cloud Platform (GCP)
NEXT_PUBLIC_GCP_PROJECT_ID=munitrack-gov-prod
NEXT_PUBLIC_GCP_REGION=us-east1
NEXT_PUBLIC_GCS_BUCKET_NAME=munitrack-expedientes-bucket

# 2. Google Document AI (Pre-validación de OCR para escrituras y CRIM)
GCP_DOC_AI_PROCESSOR_ID=tu-processor-id-de-google-cloud
GCP_DOC_AI_LOCATION=us
GCP_SERVICE_ACCOUNT_KEY={"type": "service_account", ...}

# 3. Firebase Auth / Identity Platform (Autenticación Multi-Tenant)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=munitrack-gov.firebaseapp.com

# 4. Base de Datos Google Cloud SQL (PostgreSQL Multi-Tenant con RLS)
DATABASE_URL=postgresql://munitrack_user:password@cloudsql-ip:5432/munitrack_db?sslmode=require
